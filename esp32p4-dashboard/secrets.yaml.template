# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# ESPHome API encryption key (generate with: esphome generate-apikey)
api_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OTA password
ota_password: "yourOtaPassword"

# Home Assistant long-lived access token (optional, for REST calls)
ha_token: "eyJ..."

# Navidrome / music server base URL (used on Music page)
# e.g.  http://192.168.1.50:4533
navidrome_url: "http://192.168.1.x:4533"