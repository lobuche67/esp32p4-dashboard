# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# ESPHome API encryption key (generate with: esphome generate-apikey)
api_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OTA password
ota_password: "yourOtaPassword"

# Home Assistant long-lived access token (HA Profile → Long-Lived Access Tokens)
# Store the full value including "Bearer " prefix:
ha_token: "Bearer YOUR_LONG_LIVED_ACCESS_TOKEN"

# Immich photo server
immich_url: "https://your-immich-instance"
immich_api_key: "your-immich-api-key"
# Leave empty to show random photos from all, or set to an album UUID to filter:
immich_album_uuid: ""
